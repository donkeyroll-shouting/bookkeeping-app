# Required outside local development. AUTH_SECRET is preferred by Auth.js.
AUTH_SECRET=""

# Legacy NextAuth name is also supported by this app.
NEXTAUTH_SECRET=""

# Set this to the public URL in hosted environments.
NEXTAUTH_URL="http://localhost:3000"

# Required in production. Local development falls back to admin/admin.
USERNAME="admin"
PASSWORD="admin"

# Render commonly injects PORT=10000 for Docker web services.
PORT=10000
